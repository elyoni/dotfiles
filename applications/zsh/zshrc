# Bootstrap only. Real config lives in zsh_config/*.zsh (loaded alphabetically).
zmodload zsh/datetime
typeset -g _ZSHRC_START=$EPOCHREALTIME
[[ "$DEBUG" == "true" ]] && zmodload zsh/zprof

if [[ "$CURSOR_AGENT" == "1" ]]; then
    PROMPT='%n@%m:%~%# '
    RPROMPT=''
    return
fi

# Optional machine-specific overrides (env vars, aliases, paths).
# ~/.zshrc_pc is NOT part of the dotfiles repo; create it by hand per machine.
# Sourced first, before zsh_config/*.zsh.
export ZSH_PC_SETTINGS_FILE="${HOME}/.zshrc_pc"
[[ -f "${ZSH_PC_SETTINGS_FILE}" ]] && source "${ZSH_PC_SETTINGS_FILE}"

export ZSH_CONFIGS="${HOME}/.config/zsh"
export ZSH_CUSTOM_PLUGIN="${ZSH_CONFIGS}/plugins"

# User configs (functions.zsh first defines _load_zsh_configs)
for config_file in "${ZSH_CONFIGS}"/*.zsh(N); do
    source "$config_file"
done

export ZSH_WORK_CONFIGS="${HOME}/.work_dotfiles/zsh"
_load_zsh_configs "${ZSH_WORK_CONFIGS}"

_zshrc_report  # profiling.zsh: zprof summary + load time
