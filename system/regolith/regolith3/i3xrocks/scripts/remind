#!/usr/bin/env bash
# i3xrocks blocklet: shows how many things `remind` is watching (pipelines,
# jobs, countdowns, processes, agent notifications).
#
# Right click:  watch the pipeline/job URL currently in the clipboard.
# Left click / scroll: list running + finished items; Enter opens the link,
#               Alt+d deletes a finished item.
# Middle click: remove one of the watched items from the list.
#
# When a watched item finishes, `remind` shows a notification with "OK"
# (removes it) and "Postpone" (snoozes and asks again later). Either way it
# then moves from the active list into the finished history.

REMIND="$HOME/.dotfiles/applications/remind/scripts/remind"

"$REMIND" ensure-watchers

# Left click / scroll: one list with running (⏳) and finished (✅/❌) items.
#   Enter: open the item's URL    Alt+d: delete the highlighted finished item
open_picker() {
  while true; do
    active=$("$REMIND" list)
    finished=$("$REMIND" list --finished)
    # Unified rows: id<TAB>kind<TAB>label<TAB>url<TAB>state<TAB>ago
    all=$( { echo "$active" | awk -F'\t' 'NF { print $1 "\t" $2 "\t" $3 "\t" $4 "\trunning\t" }'
             echo "$finished"; } | awk 'NF')
    if [ -z "$all" ]; then
      notify-send -t 3000 "Remind" "Nothing watched or finished.\nRight-click to watch the pipeline/job link in your clipboard."
      return
    fi
    entries=$(echo "$all" | awk -F'\t' '{
      icon = ($5 == "running") ? "⏳" : ($5 == "failed") ? "❌" : ($5 == "success" || $5 == "done") ? "✅" : "⚪"
      ago = ($6 != "") ? " (" $5 ", " $6 ")" : ""
      printf "%s %s  [%s] %s%s\n", icon, $1, $2, $3, ago
    }')
    [ -n "$finished" ] && entries=$(printf "🗑  Clear all finished\n%s" "$entries")
    choice=$(echo "$entries" | rofi -dmenu -i -p "Remind" \
      -mesg "Enter: open link · Alt+d: delete finished item" -kb-custom-1 "Alt+d")
    rc=$?
    [ -z "$choice" ] && return
    if [ "${choice#🗑}" != "$choice" ]; then
      "$REMIND" clear-finished
      return
    fi
    chosen_id=$(echo "$choice" | awk '{ print $2 }')
    if [ "$rc" -eq 10 ]; then
      "$REMIND" remove-finished "$chosen_id"
      continue
    fi
    url=$(echo "$all" | awk -F'\t' -v id="$chosen_id" '$1 == id { print $4 }')
    if [ -n "$url" ] && [ "$url" != "-" ]; then
      xdg-open "$url" >/dev/null 2>&1 &
    else
      notify-send -t 3000 "Remind" "Nothing to open for this reminder."
    fi
    return
  done
}

# Each line from `remind list` is: id<TAB>kind<TAB>label<TAB>url-or-"-"
to_display_line() {
  awk -F'\t' '{ printf "%s  [%s] %s\n", $1, $2, $3 }'
}

id_from_display_line() {
  awk '{ print $1 }'
}

case "$BLOCK_BUTTON" in
  1|4|5) # left click / scroll: running + finished list
    open_picker
    ;;
  2) # middle click: remove a watched item
    items=$("$REMIND" list)
    if [ -n "$items" ]; then
      choice=$(echo "$items" | to_display_line | rofi -dmenu -p "Stop watching")
      if [ -n "$choice" ]; then
        chosen_id=$(echo "$choice" | id_from_display_line)
        "$REMIND" remove "$chosen_id"
      fi
    fi
    ;;
  3) # right click: watch the pipeline/job link in the clipboard
    url=$(xclip -o -selection clipboard 2>/dev/null)
    if [[ "$url" =~ ^https?://[^/]+/.+/-/pipelines/[0-9]+ ]]; then
      "$REMIND" add pipeline "$url" &
      disown
    elif [[ "$url" =~ ^https?://[^/]+/.+/-/jobs/[0-9]+ ]]; then
      "$REMIND" add job "$url" &
      disown
    else
      notify-send -t 3000 "Remind" "Clipboard doesn't look like a pipeline/job URL:\n$url"
    fi
    ;;
esac

running=$("$REMIND" list | wc -l)
failed=$("$REMIND" list --finished | awk -F'\t' '$5 == "failed"' | wc -l)

if [ "$running" -gt 0 ] && [ "$failed" -gt 0 ]; then
  text="❌🔧$running"; color="#FF6B6B"
elif [ "$running" -gt 0 ]; then
  text="🔧$running"; color="#91E78B"
elif [ "$failed" -gt 0 ]; then
  text="❌"; color="#FF6B6B"
else
  text="💤"; color="#888888"
fi
echo "$text"
echo "$text"
echo "$color"
