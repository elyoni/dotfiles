#!/usr/bin/env bash
# i3xrocks blocklet: Pomodoro-style work/break cycle.
#
#   work (countdown) --timeout--> blocking popup
#                                  --user clicks "Start Break"--> break (countdown)
#                                  --user clicks "Postpone 5 min"--> work (countdown, +5 min)
#                                  --user clicks "Big Break"--> prompts for minutes, then break (countdown)
#                                  --user goes idle >= AWAY_THRESHOLD_MIN--> break (countdown, backdated
#                                    to when idleness began - see docs/adr/0002-pomodoro-idle-triggered-break.md)
#   break (countdown) --timeout--> blocking popup + phone/Garmin ping
#                                   --user clicks "I'm back"--> work (countdown)
#
# Tasks come from the "## Today" checklist of today's daily note (open
# [ ] / [~] / [!] items), picked via a checklist; "Add new task" appends a
# new "- [ ]" line to the note first.
#
# Left click:  idle -> prompt for work/break minutes, pick tasks, and start.
#              work -> ask whether to split the session (log segment so far,
#                       mark finished tasks [x], pick next tasks, countdown
#                       keeps running), skip to break, change duration, or stop.
#              break -> ask whether to change duration or stop.
#              awaiting_break/awaiting_return -> show a quick status
#                                       notification (no interruption).
# Right click: idle -> verify the ntfy notification setup (send a test
#                        message and confirm it arrived).
#              running -> ask for confirmation, then stop the whole cycle
#                          and go idle (guards against an accidental click).
#
# Setup for the phone/Garmin ping (optional, same as the `break` widget):
#   1. Install the ntfy app (https://ntfy.sh) on your phone.
#   2. Pick a private/random topic name and subscribe to it in the app.
#   3. echo "your-topic-name" > ~/.config/ntfy-topic
#   4. In Garmin Connect Mobile, enable notification mirroring for the ntfy app.
#
# Every backgrounded popup/dialog is spawned with its stdin/stdout/stderr
# redirected away from this script's own (</dev/null >/dev/null 2>&1 &).
# i3xrocks reads a block's output by waiting for its stdout pipe to reach
# EOF; without the redirect, a detached zenity dialog keeps that pipe open
# for as long as it's on screen, freezing this blocklet's redraws until the
# dialog is dismissed. Every new backgrounded spawn must follow the same
# pattern.

STATE_FILE="/tmp/pomodoro_state"           # work | awaiting_break | break | awaiting_return
TARGET_FILE="/tmp/pomodoro_target_time"    # epoch seconds when current phase ends
WORK_MIN_FILE="/tmp/pomodoro_work_minutes"
BREAK_MIN_FILE="/tmp/pomodoro_break_minutes"
TASK_FILE="/tmp/pomodoro_task"             # current work session's task label
SESSION_START_FILE="/tmp/pomodoro_session_start"  # epoch seconds when this work session began
BREAK_START_FILE="/tmp/pomodoro_break_start"      # epoch seconds when the current break began
NTFY_TOPIC_FILE="$HOME/.config/ntfy-topic"

VAULT_ROOT="/home/yonie@liveu.tv/private/obsidian/work"
DAILY_NOTES_DIR="$VAULT_ROOT/00-Inbox/daily-notes"
DAILY_NOTE_TEMPLATE="$VAULT_ROOT/04-Meta/templates/daily-note.md"

DEFAULT_WORK_MIN=25
DEFAULT_BREAK_MIN=5
DEFAULT_BIG_BREAK_MIN=15
POSTPONE_MIN=5
AWAY_THRESHOLD_MIN=5   # idle minutes (via xprintidle) during awaiting_break before it counts as your break

BUTTON=${button:-${BLOCK_BUTTON:-}}

state() { cat "$STATE_FILE" 2>/dev/null; }

# Multi-line replacement for `zenity --entry`: opens an editable text box
# prefilled with $2 (works for multi-line prefill too, unlike --entry-text)
# and labelled by $3. Prints the edited text on stdout; empty if cancelled.
ask_multiline() {
    local title="$1" prefill="$2" prompt="$3"
    printf '%s' "$prefill" | zenity --text-info --editable \
        --title="$title" --text="$prompt" --width=480 --height=280 2>/dev/null
}

stop_cycle() {
    rm -f "$STATE_FILE" "$TARGET_FILE" "$WORK_MIN_FILE" "$BREAK_MIN_FILE" "$TASK_FILE" "$SESSION_START_FILE" "$BREAK_START_FILE"
}

# Returns today's daily note path on stdout, creating it from the vault's
# daily-note template (same one nvim's obsidian_workflow.lua ensure_daily_note
# uses) if it doesn't exist yet. Fails only if the template itself is missing.
ensure_daily_note() {
    local date="$1"
    local daily_note="$DAILY_NOTES_DIR/${date}.md"

    if [ -f "$daily_note" ]; then
        echo "$daily_note"
        return 0
    fi

    [ -f "$DAILY_NOTE_TEMPLATE" ] || return 1

    mkdir -p "$DAILY_NOTES_DIR"
    sed -e "s/{{date:[^}]*}}/${date}/g" -e "s/{{date}}/${date}/g" \
        "$DAILY_NOTE_TEMPLATE" > "$daily_note"
    echo "$daily_note"
}

# Prints the open tasks (one per line, checkbox prefix stripped) from the
# "## Today" section of the given daily note. Open = [ ] / [~] / [!].
open_tasks() {
    awk '
        /^## / { in_t = ($0 == "## Today"); next }
        in_t && match($0, /^- \[[ ~!]\] /) { print substr($0, RLENGTH + 1) }
    ' "$1"
}

# Appends "- [ ] <task>" to the "## Today" section of today's daily note
# (after the last existing line of that section), creating the heading if
# the note somehow lacks it.
add_task_to_note() {
    local task="$1" note
    note=$(ensure_daily_note "$(date +%Y-%m-%d)") || return 1
    TASK="$task" awk '
        { lines[NR] = $0 }
        /^## / { in_t = ($0 == "## Today"); if (in_t) { found = 1; ins = NR }; next }
        in_t && /^[ \t]*[^ \t]/ { ins = NR }
        in_t && /^- \[.\] /     { has_task = 1 }
        END {
            for (i = 1; i <= NR; i++) {
                print lines[i]
                if (found && i == ins) {
                    if (!has_task) print ""
                    print "- [ ] " ENVIRON["TASK"]
                }
            }
            if (!found) { print ""; print "## Today"; print ""; print "- [ ] " ENVIRON["TASK"] }
        }
    ' "$note" > "$note.tmp" && mv "$note.tmp" "$note"
}

# Flips the first matching open task in "## Today" to "- [x]".
mark_task_done() {
    local task="$1" note
    note=$(ensure_daily_note "$(date +%Y-%m-%d)") || return 1
    TASK="$task" awk '
        /^## / { in_t = ($0 == "## Today") }
        in_t && !done && match($0, /^- \[[ ~!]\] /) && substr($0, RLENGTH + 1) == ENVIRON["TASK"] {
            $0 = "- [x] " ENVIRON["TASK"]; done = 1
        }
        { print }
    ' "$note" > "$note.tmp" && mv "$note.tmp" "$note"
}

# Checklist of today's open daily-note tasks. $1 = newline-separated labels to
# preselect. Prints the chosen tasks, one per line. The last row, "Add new
# task", prompts for a label, appends it to the daily note and includes it.
# Returns 1 if the dialog was cancelled. Falls back to a free-text box if the
# daily note can't be created.
pick_tasks() {
    local preselect="$1" note out sel i id label
    local -a tasks=() rows=() ids=() chosen=()

    if ! note=$(ensure_daily_note "$(date +%Y-%m-%d)"); then
        ask_multiline "Pomodoro" "$preselect" "What are you working on? (multiple lines OK)"
        return 0
    fi

    mapfile -t tasks < <(open_tasks "$note")
    for i in "${!tasks[@]}"; do
        sel=FALSE
        grep -qxF -- "${tasks[$i]}" <<<"$preselect" && sel=TRUE
        rows+=("$sel" "$i" "${tasks[$i]}")
    done
    rows+=(FALSE new "➕ Add new task…")

    out=$(zenity --list --checklist --title "Pick Tasks" \
        --text "Which task(s) are you working on?" \
        --column=Pick --column=ID --column=Task --hide-column=2 --print-column=2 \
        --separator=, --width=640 --height=420 --ok-label="Start" \
        "${rows[@]}" 2>/dev/null) || return 1

    IFS=, read -ra ids <<<"$out"
    for id in "${ids[@]}"; do
        if [ "$id" = "new" ]; then
            label=$(zenity --entry --title "New Task" --text "New task (added to today's daily note):" 2>/dev/null)
            if [ -n "$label" ]; then
                add_task_to_note "$label"
                chosen+=("$label")
            fi
        elif [ -n "$id" ]; then
            chosen+=("${tasks[$id]}")
        fi
    done
    [ "${#chosen[@]}" -gt 0 ] && printf '%s\n' "${chosen[@]}"
    return 0
}

# Checklist over the current session's tasks ($1, newline-separated); prints
# the ones ticked as finished, one per line. Cancel/none -> prints nothing.
pick_finished() {
    local tasks="$1" out id line
    local -a items=() rows=() ids=()
    [ -n "$tasks" ] || return 0

    mapfile -t items <<<"$tasks"
    for id in "${!items[@]}"; do
        rows+=(FALSE "$id" "${items[$id]}")
    done

    out=$(zenity --list --checklist --title "Finished?" \
        --text "Which task(s) did you finish? (marked [x] in the daily note)" \
        --column=Done --column=ID --column=Task --hide-column=2 --print-column=2 \
        --separator=, --width=640 --height=360 --ok-label="Mark done" \
        "${rows[@]}" 2>/dev/null) || return 0

    IFS=, read -ra ids <<<"$out"
    for id in "${ids[@]}"; do
        [ -n "$id" ] && printf '%s\n' "${items[$id]}"
    done
    return 0
}

# Appends one completed work-session entry to today's daily note under a
# "## Pomodoro" heading, creating the note from the template (and the
# heading, if it's not there yet) as needed. Skipped entirely by the caller
# when both planned and actual are unknown (start and end prompt both
# dismissed) - a fully unlabeled session isn't worth logging.
#
# Shows planned vs. actual as two blocks (each may be multi-line) whenever
# they differ, so drift between what you meant to do and what you did is
# visible at a glance; collapses to one block when they match or actual
# was left blank.
log_session() {
    local planned="$1" actual="$2" start_epoch="$3" end_epoch="$4"
    local daily_note
    daily_note=$(ensure_daily_note "$(date +%Y-%m-%d)") || return 0

    local heading body entry
    heading="### $(date -d "@$start_epoch" +%H:%M)–$(date -d "@$end_epoch" +%H:%M)"

    if [ -z "$actual" ] || [ "$planned" = "$actual" ]; then
        body="${actual:-$planned}"
    else
        body=$(printf '**Planned**\n%s\n\n**Actual**\n%s' "${planned:-_(none)_}" "$actual")
    fi

    entry=$(printf '%s\n\n%s' "$heading" "$body")

    if grep -qxF "## Pomodoro" "$daily_note"; then
        awk -v entry="$entry" '
            { print }
            !done && $0 == "## Pomodoro" { print ""; print entry; print ""; done=1 }
        ' "$daily_note" > "$daily_note.tmp" && mv "$daily_note.tmp" "$daily_note"
    else
        printf '\n## Pomodoro\n\n%s\n\n' "$entry" >> "$daily_note"
    fi
}

# Right-click-while-running handler: guards against an accidental click
# wiping out a running timer. Dismissing or declining leaves it untouched.
confirm_stop_cycle() {
    zenity --question --title "Pomodoro" \
        --text="Stop the current pomodoro cycle?" \
        --ok-label="Stop" --cancel-label="Keep going" 2>/dev/null
    if [ $? -eq 0 ]; then
        # Only a stop mid-work is a session to log - during break/awaiting_return
        # there's no in-progress work session, and the last one already logged
        # when it completed.
        [ "$(state)" = "work" ] && log_completed_session
        stop_cycle
        notify-send "Pomodoro" "Timer stopped"
    fi
}

# Prompts for a new ntfy topic and saves it. Requires a non-empty value;
# cancelling the dialog aborts without touching the topic file.
set_ntfy_topic() {
    local topic
    while true; do
        topic=$(zenity --entry --title "ntfy Topic" \
            --text "Enter a private/random ntfy.sh topic name (subscribe to it in the ntfy app):" 2>/dev/null) || return 1
        if [ -z "$topic" ]; then
            zenity --error --title "ntfy Topic" --text "Topic name can't be empty." 2>/dev/null
            continue
        fi
        mkdir -p "$(dirname "$NTFY_TOPIC_FILE")"
        echo "$topic" > "$NTFY_TOPIC_FILE"
        return 0
    done
}

# Right-click-while-idle handler. Offers to set up a topic if none exists,
# then sends a real test push and asks the user to confirm it arrived,
# looping back to a fresh topic if it didn't.
verify_notifications() {
    if ! command -v curl >/dev/null 2>&1; then
        zenity --error --title "Verify Notifications" --text "curl isn't installed, can't send a test notification." 2>/dev/null
        return
    fi

    if [ ! -f "$NTFY_TOPIC_FILE" ]; then
        zenity --question --title "Verify Notifications" \
            --text="No ntfy topic is configured yet.\n\nWould you like to set one up now?" \
            --ok-label="Set up topic" --cancel-label="Not now" 2>/dev/null
        [ $? -eq 0 ] || return
        set_ntfy_topic || return
    fi

    local topic output rc
    while true; do
        topic=$(cat "$NTFY_TOPIC_FILE" 2>/dev/null)

        curl -s -H "Title: Pomodoro Test" -H "Tags: bell" \
            -d "Test notification - if you got this, your ntfy setup works!" \
            "https://ntfy.sh/${topic}" >/dev/null 2>&1

        output=$(zenity --question --title "Verify Notifications" \
            --text="A test notification was sent to ntfy topic '${topic}'.\n\nDid you receive it on your phone/watch?" \
            --ok-label="Yes, it worked" --extra-button="No, change topic" 2>/dev/null)
        rc=$?

        if [ "$output" = "No, change topic" ]; then
            set_ntfy_topic || return
            continue
        elif [ "$rc" -eq 0 ]; then
            zenity --info --title "Verify Notifications" --text="Notifications are working." 2>/dev/null
            return
        else
            # Dismissed via X/Esc - just stop; this is a manual diagnostic,
            # not a required step in a running timer, so no retry loop.
            return
        fi
    done
}

# Skips the rest of the work countdown and goes straight to break. Logs the
# just-ended work session first, same as any other path into a break.
skip_to_break() {
    log_completed_session

    break_min=$(cat "$BREAK_MIN_FILE" 2>/dev/null)
    break_min=${break_min:-$DEFAULT_BREAK_MIN}

    now=$(date +%s)
    echo "$now" > "$BREAK_START_FILE"
    echo $(( now + break_min * 60 )) > "$TARGET_FILE"
    echo "break" > "$STATE_FILE"
    notify-send "Pomodoro" "Skipped to break"
}

# Prompts for this phase's new TOTAL length in minutes (not minutes
# remaining) and, if valid, retargets the running countdown to
# phase_start + new_total - preserving elapsed time instead of restarting
# the phase. Also updates the matching WORK_MIN_FILE/BREAK_MIN_FILE so the
# new length becomes the default for future phases too.
# See CONTEXT.md "Retarget".
retarget_phase() {
    local phase="$1"  # work | break
    local min_file phase_start_file default_min current_min minutes phase_start

    if [ "$phase" = "work" ]; then
        min_file="$WORK_MIN_FILE"; phase_start_file="$SESSION_START_FILE"; default_min=$DEFAULT_WORK_MIN
    else
        min_file="$BREAK_MIN_FILE"; phase_start_file="$BREAK_START_FILE"; default_min=$DEFAULT_BREAK_MIN
    fi

    current_min=$(cat "$min_file" 2>/dev/null)
    current_min=${current_min:-$default_min}

    minutes=$(zenity --entry --title "Change Duration" \
        --text "New total ${phase} length (minutes):" --entry-text "$current_min" 2>/dev/null) || return 1
    if ! [[ "$minutes" =~ ^[0-9]+$ ]] || [ "$minutes" -eq 0 ]; then
        zenity --error --text "Enter a whole number of minutes greater than 0." 2>/dev/null
        return 1
    fi

    phase_start=$(cat "$phase_start_file" 2>/dev/null)
    [ -n "$phase_start" ] || phase_start=$(date +%s)

    echo "$minutes" > "$min_file"
    echo $(( phase_start + minutes * 60 )) > "$TARGET_FILE"
    notify-send "Pomodoro" "${phase^} length set to ${minutes}m"
}

# Left-click-while-working handler: only called for "work" (not
# "awaiting_break") so it can't race with a spawn_break_dialog popup that's
# already open. Dismissing the dialog does nothing.
#
# Choices are --extra-button's rather than the default OK/Cancel: the exit
# code zenity returns for the --ok-label button isn't reliable across
# versions when mixed with --extra-button, but the printed button text is
# always accurate, so matching on stdout instead of $? is what's robust here.
ask_skip_or_stop() {
    output=$(zenity --question --title "Pomodoro" \
        --text="Split the session, skip to break, change duration, or stop the timer?" \
        --ok-label="Cancel" \
        --extra-button="Split Task" --extra-button="Go to Break" --extra-button="Change Duration" --extra-button="Stop Timer" 2>/dev/null)

    case "$output" in
        "Split Task") split_session ;;
        "Go to Break") skip_to_break ;;
        "Change Duration") retarget_phase work ;;
        "Stop Timer") log_completed_session; stop_cycle ;;
    esac
}

# Left-click-while-on-break handler: mirrors ask_skip_or_stop for the break
# phase. Dismissing (X/Esc) does nothing, same as Cancel used to - so Cancel
# itself was dropped as redundant.
ask_change_break_or_stop() {
    output=$(zenity --question --title "Pomodoro" \
        --text="Change duration, return to work, or stop the timer?" \
        --ok-label="Change Duration" \
        --extra-button="Return to Job" --extra-button="Stop Timer" 2>/dev/null)

    case "$output" in
        "Change Duration") retarget_phase break ;;
        "Return to Job") return_to_work ;;
        "Stop Timer") stop_cycle; notify-send "Pomodoro" "Timer stopped" ;;
    esac
}

start_cycle() {
    local work_min break_min task target

    work_min=$(zenity --entry --title "Start Pomodoro" --text "Work minutes:" --entry-text "$DEFAULT_WORK_MIN" 2>/dev/null) || return 1
    if ! [[ "$work_min" =~ ^[0-9]+$ ]] || [ "$work_min" -eq 0 ]; then
        zenity --error --text "Enter a whole number of minutes greater than 0." 2>/dev/null
        return 1
    fi

    break_min=$(zenity --entry --title "Start Pomodoro" --text "Break minutes:" --entry-text "$DEFAULT_BREAK_MIN" 2>/dev/null) || return 1
    if ! [[ "$break_min" =~ ^[0-9]+$ ]] || [ "$break_min" -eq 0 ]; then
        zenity --error --text "Enter a whole number of minutes greater than 0." 2>/dev/null
        return 1
    fi

    # No answer here just means the task label starts empty - the end-of-session
    # prompt still fires, and only a fully unlabeled session is left unlogged.
    task=$(pick_tasks "")

    echo "$work_min" > "$WORK_MIN_FILE"
    echo "$break_min" > "$BREAK_MIN_FILE"
    echo "$task" > "$TASK_FILE"

    date +%s > "$SESSION_START_FILE"
    target=$(( $(date +%s) + work_min * 60 ))
    echo "$target" > "$TARGET_FILE"
    echo "work" > "$STATE_FILE"
}

show_status() {
    local current="$1" remaining="$2"
    local phase_label
    case "$current" in
        work) phase_label="Work session" ;;
        awaiting_break) phase_label="Waiting for you to start your break" ;;
        break) phase_label="Break" ;;
        awaiting_return) phase_label="Waiting for you to return" ;;
    esac
    notify-send "Pomodoro" "${phase_label}: $((remaining / 60))m $((remaining % 60))s left"
}

# Prompts for a custom big-break length. Returns the minutes on stdout;
# cancelling or entering an invalid value returns non-zero so the caller
# can fall back to re-showing the work-session-done popup.
prompt_big_break_minutes() {
    local minutes
    minutes=$(zenity --entry --title "Big Break" --text "Big break length (minutes):" --entry-text "$DEFAULT_BIG_BREAK_MIN" 2>/dev/null) || return 1
    if ! [[ "$minutes" =~ ^[0-9]+$ ]] || [ "$minutes" -eq 0 ]; then
        zenity --error --text "Enter a whole number of minutes greater than 0." 2>/dev/null
        return 1
    fi
    echo "$minutes"
}

# Spawns the blocking "start your break" popup. Only called once, from the
# work -> awaiting_break transition below, so it can't double-spawn.
# The "Postpone"/"Big Break" extra buttons make zenity exit non-zero but
# print the button's label on stdout, which is how we tell them apart from
# an X/Esc dismissal (also non-zero, but with empty output).
#
# Re-checks state at the top of every iteration so it can bail out quietly
# if watch_away already handled the transition to break out from under it
# (killing the zenity dialog mid-wait, see watch_away below) - it must not
# re-log or re-transition on top of what watch_away already did.
spawn_break_dialog() {
    (
        while true; do
            [ "$(state)" = "awaiting_break" ] || exit 0

            output=$(zenity --info --title "Pomodoro Break Time" \
                --text="<span font='20' weight='bold'>Work session done, time for a break! Click \"Start Break\" when you're ready, postpone if you're mid-task, or take a big break.</span>" \
                --width=400 --ok-label="Start Break" \
                --extra-button="Postpone ${POSTPONE_MIN} min" --extra-button="Big Break" 2>/dev/null)
            rc=$?

            if [ "$output" = "Postpone ${POSTPONE_MIN} min" ]; then
                echo $(( $(date +%s) + POSTPONE_MIN * 60 )) > "$TARGET_FILE"
                echo "work" > "$STATE_FILE"
                notify-send "Pomodoro" "Break postponed ${POSTPONE_MIN} more minutes"
                exit 0
            fi

            if [ "$output" = "Big Break" ]; then
                big_min=$(prompt_big_break_minutes) || continue
                log_completed_session
                now=$(date +%s)
                echo "$now" > "$BREAK_START_FILE"
                echo $(( now + big_min * 60 )) > "$TARGET_FILE"
                echo "break" > "$STATE_FILE"
                notify-send "Pomodoro" "Big break started (${big_min}m)"
                exit 0
            fi

            [ "$rc" -eq 0 ] && break
            # Dismissed via X/Esc instead of a button (or zenity couldn't
            # run at all, e.g. no display) - wait a beat and ask again rather
            # than spinning in a tight retry loop.
            sleep 2
        done

        log_completed_session

        break_min=$(cat "$BREAK_MIN_FILE" 2>/dev/null)
        break_min=${break_min:-$DEFAULT_BREAK_MIN}

        now=$(date +%s)
        echo "$now" > "$BREAK_START_FILE"
        echo $(( now + break_min * 60 )) > "$TARGET_FILE"
        echo "break" > "$STATE_FILE"
        notify-send "Pomodoro" "Break started"
    ) </dev/null >/dev/null 2>&1 &
    disown
}

# Polls xprintidle every 15s while state is awaiting_break. Once idle time
# crosses AWAY_THRESHOLD_MIN, treats the idle time itself as the break -
# backdating the break's start to when idleness began rather than to when
# it's detected - and kills the pending "Start Break" popup so it doesn't
# linger or double-transition. See docs/adr/0002-pomodoro-idle-triggered-break.md.
# No-ops entirely if xprintidle isn't installed (`sudo apt install xprintidle`,
# also wired into system/i3/install.sh).
watch_away() {
    command -v xprintidle >/dev/null 2>&1 || return 0
    (
        while true; do
            sleep 15
            [ "$(state)" = "awaiting_break" ] || exit 0

            idle_ms=$(xprintidle 2>/dev/null) || exit 0
            if [ "$idle_ms" -ge $(( AWAY_THRESHOLD_MIN * 60 * 1000 )) ]; then
                pkill -f 'ok-label=Start Break' 2>/dev/null

                log_completed_session

                break_min=$(cat "$BREAK_MIN_FILE" 2>/dev/null)
                break_min=${break_min:-$DEFAULT_BREAK_MIN}

                idle_start=$(( $(date +%s) - idle_ms / 1000 ))
                echo "$idle_start" > "$BREAK_START_FILE"
                echo $(( idle_start + break_min * 60 )) > "$TARGET_FILE"
                echo "break" > "$STATE_FILE"
                notify-send "Pomodoro" "Looks like you stepped away - counting it as your break"
                exit 0
            fi
        done
    ) </dev/null >/dev/null 2>&1 &
    disown
}

# Asks what was actually worked on (prefilled with the start-of-session
# answer, so drift is easy to correct) and logs the session. If either the
# start or the end prompt was left unanswered, the session is unlabeled and
# is not logged at all - only fully-labeled sessions count as working time.
log_completed_session() {
    local start_epoch started_task end_task

    start_epoch=$(cat "$SESSION_START_FILE" 2>/dev/null)
    started_task=$(cat "$TASK_FILE" 2>/dev/null)

    if [ -z "$start_epoch" ]; then
        return 0
    fi

    end_task=$(ask_multiline "Work Session Done" "$started_task" \
        "What did you actually work on? (multiple lines OK)")

    if [ -z "$started_task" ] && [ -z "$end_task" ]; then
        return 0
    fi

    log_session "$started_task" "$end_task" "$start_epoch" "$(date +%s)"
}

# Splits the running work session without touching the countdown: logs the
# segment so far (start -> now) to the daily note, lets you tick which tasks
# are finished (marked [x] in "## Today"), then picks what you continue with.
# The next segment starts now and still ends at the original target time.
split_session() {
    local tasks finished remaining line next now
    tasks=$(cat "$TASK_FILE" 2>/dev/null)

    log_completed_session
    now=$(date +%s)

    finished=$(pick_finished "$tasks")
    remaining="$tasks"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        mark_task_done "$line"
        remaining=$(grep -vxF -- "$line" <<<"$remaining")
    done <<<"$finished"

    # Cancelling the picker keeps the unfinished tasks as the current ones.
    if next=$(pick_tasks "$remaining"); then
        remaining="$next"
    fi

    echo "$remaining" > "$TASK_FILE"
    echo "$now" > "$SESSION_START_FILE"
    notify-send "Pomodoro" "Session split - segment logged"
}

# Ends the break right now and starts a fresh work phase: prompts for the
# task, resets the session-start/target files, and flips state to "work".
# Shared by spawn_return_dialog (break timeout -> "I'm back") and the
# break-menu "Return to Job" button (manual early return).
return_to_work() {
    work_min=$(cat "$WORK_MIN_FILE" 2>/dev/null)
    work_min=${work_min:-$DEFAULT_WORK_MIN}

    # Cancelling the picker keeps the previous session's task(s).
    if task=$(pick_tasks "$(cat "$TASK_FILE" 2>/dev/null)"); then
        echo "$task" > "$TASK_FILE"
    fi

    date +%s > "$SESSION_START_FILE"
    echo $(( $(date +%s) + work_min * 60 )) > "$TARGET_FILE"
    echo "work" > "$STATE_FILE"
    notify-send "Pomodoro" "Back to work"
}

# Spawns the blocking "come back" popup. Only called once, from the
# break -> awaiting_return transition below, so it can't double-spawn.
spawn_return_dialog() {
    (
        while true; do
            zenity --info --title "Pomodoro Return" \
                --text="<span font='20' weight='bold'>Break's over! Click \"I'm back\" when you're at the computer.</span>" \
                --width=400 --ok-label="I'm back" 2>/dev/null
            [ $? -eq 0 ] && break
            # Dismissed via X/Esc instead of the button (or zenity couldn't
            # run at all, e.g. no display) - wait a beat and ask again rather
            # than spinning in a tight retry loop.
            sleep 2
        done

        return_to_work
    ) </dev/null >/dev/null 2>&1 &
    disown
}

case "x${BUTTON}" in
    x1)
        current=$(state)
        if [ -z "$current" ]; then
            ( start_cycle ) </dev/null >/dev/null 2>&1 &
            disown
        elif [ "$current" = "work" ]; then
            ( ask_skip_or_stop ) </dev/null >/dev/null 2>&1 &
            disown
        elif [ "$current" = "break" ]; then
            ( ask_change_break_or_stop ) </dev/null >/dev/null 2>&1 &
            disown
        else
            target=$(cat "$TARGET_FILE" 2>/dev/null)
            remaining=$(( ${target:-0} - $(date +%s) ))
            [ "$remaining" -lt 0 ] && remaining=0
            show_status "$current" "$remaining" </dev/null >/dev/null 2>&1 &
            disown
        fi
        ;;
    x3)
        current=$(state)
        if [ -z "$current" ]; then
            ( verify_notifications ) </dev/null >/dev/null 2>&1 &
            disown
        else
            ( confirm_stop_cycle ) </dev/null >/dev/null 2>&1 &
            disown
        fi
        ;;
esac

CURRENT_STATE=$(state)

if [ -z "$CURRENT_STATE" ]; then
    echo "🍅 --"
    echo "🍅 --"
    exit 0
fi

TARGET_TIME=$(cat "$TARGET_FILE" 2>/dev/null)
if ! [[ "$TARGET_TIME" =~ ^[0-9]+$ ]]; then
    stop_cycle
    echo "🍅 --"
    echo "🍅 --"
    exit 0
fi

REMAINING=$((TARGET_TIME - $(date +%s)))

case "$CURRENT_STATE" in
    work)
        if [ "$REMAINING" -gt 0 ]; then
            MIN=$((REMAINING / 60)); SEC=$((REMAINING % 60))
            printf "🍅 %02d:%02d\n" "$MIN" "$SEC"
            printf "🍅 %02d:%02d\n" "$MIN" "$SEC"
            echo "#91E78B"
        else
            echo "awaiting_break" > "$STATE_FILE"
            spawn_break_dialog
            watch_away
            echo "🍅 Break!"
            echo "🍅 Break!"
            echo "#F79494"
        fi
        ;;
    awaiting_break)
        # Counts up from the moment the work timer hit zero until the user
        # picks a button on the popup, so a forgotten popup is obvious.
        OVERTIME=$(( -REMAINING ))
        MIN=$((OVERTIME / 60)); SEC=$((OVERTIME % 60))
        printf "🍅 Break! +%02d:%02d\n" "$MIN" "$SEC"
        printf "🍅 Break! +%02d:%02d\n" "$MIN" "$SEC"
        echo "#F79494"
        ;;
    break)
        if [ "$REMAINING" -gt 0 ]; then
            MIN=$((REMAINING / 60)); SEC=$((REMAINING % 60))
            printf "☕ %02d:%02d\n" "$MIN" "$SEC"
            printf "☕ %02d:%02d\n" "$MIN" "$SEC"
            echo "#91E78B"
        else
            echo "awaiting_return" > "$STATE_FILE"

            if [ -f "$NTFY_TOPIC_FILE" ] && command -v curl >/dev/null 2>&1; then
                NTFY_TOPIC=$(cat "$NTFY_TOPIC_FILE" 2>/dev/null)
                if [ -n "$NTFY_TOPIC" ]; then
                    curl -s -H "Title: Pomodoro" -H "Tags: alarm_clock" \
                        -d "Break is over, back to the computer" \
                        "https://ntfy.sh/${NTFY_TOPIC}" >/dev/null 2>&1 &
                fi
            fi

            spawn_return_dialog

            echo "☕ Return!"
            echo "☕ Return!"
            echo "#F79494"
        fi
        ;;
    awaiting_return)
        # Blink between two labels each second so it's noticeable while
        # waiting for the popup to be acknowledged. Break overtime isn't
        # counted (unlike work overtime) since going over on a break isn't
        # something to track.
        if (( $(date +%s) % 2 == 0 )); then
            echo "☕ Return!"
            echo "☕ Return!"
        else
            echo "☕ ...."
            echo "☕ ...."
        fi
        echo "#F79494"
        ;;
esac
